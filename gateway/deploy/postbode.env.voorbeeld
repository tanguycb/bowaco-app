# /etc/bowaco-postbode/postbode.env — gewone instellingen van de gateway (v2, stap 3.1). GEEN sleutels: die staan in
# sleutels.env (root 0600, zie sleutels.env.voorbeeld). Kopieer dit bestand op de SERVER en vul in.
# Rechten: root:postbode 0640.

# De backend van de app (canister-id): de draft of de live-app (eigenaar).
BOWACO_CANISTER=
IC_HOST=https://icp-api.io

# De sleutel van de robot (gemaakt met: sudo -u postbode node /opt/bowaco-postbode/src/sleutel.ts /etc/bowaco-postbode/robot.json)
ROBOT_KEY_FILE=/etc/bowaco-postbode/robot.json

# HTTP (enkel lokaal; Caddy zet er HTTPS voor). ALLOW_ORIGIN = het adres van de app (op een draft het draftadres),
# schema + host zonder pad. Enkel die Origin mag /v2/* gebruiken (anders 403 origin).
HTTP_HOST=127.0.0.1
HTTP_PORT=8787
ALLOW_ORIGIN=

# Staat: budget.json en log/<jjjj-mm>.jsonl (zonder inhoud), bewaard GATEWAY_LOG_DAGEN dagen.
GATEWAY_STAAT=/var/lib/bowaco-postbode
GATEWAY_LOG_DAGEN=400

# Budget (eurocent per maand) bovenop het ticketbudget van de app, en de koers (zelfde waarde als ai.usdEurMilli
# in de app; 920 = 0,920 €/$). Leeg = standaard (maandplafond 10 000 = € 100; per leverancier = het maandplafond).
GATEWAY_MAANDPLAFOND_CENT=
GATEWAY_PLAFOND_CLAUDE_CENT=
GATEWAY_PLAFOND_GROK_CENT=
GATEWAY_USD_EUR_MILLI=

# Grenzen (leeg = standaard): 10 bestanden, 20 MB samen, 15 MB per bestand, 60 PDF-bladen, 5 000 rijen per blad,
# 120 s per taak, 4 taken tegelijk.
GATEWAY_MAX_BESTANDEN=
GATEWAY_MAX_TOTAAL_MB=
GATEWAY_MAX_BESTAND_MB=
GATEWAY_TIJDSLIMIET_MS=
GATEWAY_GELIJKTIJDIG=

# NOOIT op de echte server: GATEWAY_NEP=1 zet de nep-leverancier aan (enkel tests en lokaal net).
# Niet meer gebruikt / nog niet gebouwd (de gateway weigert te starten als ze er staan): MAIL_PROVIDER,
# BREVO_API_KEY, INBOX_PROVIDER, INBOX_WEBHOOK_SECRET, INBOX_ALLOWED_DOMAIN.
