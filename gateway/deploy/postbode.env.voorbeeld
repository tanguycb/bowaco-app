# /etc/bowaco-postbode/postbode.env — omgeving van de postbode (stap 1b.3).
# Kopieer dit bestand op de SERVER naar /etc/bowaco-postbode/postbode.env en vul in. Rechten: root:postbode 0640.
# Dit bestand bevat een geheim (de API-sleutel van de maildienst): NOOIT in git, mail, chat of een Claude-sessie.

# De backend van de app (canister-id). Draft: w5pbr-raaaa-aaaal-qs3aq-cai. Live: het id van de live-app (eigenaar).
BOWACO_CANISTER=w5pbr-raaaa-aaaal-qs3aq-cai
IC_HOST=https://icp-api.io

# De sleutel van de robot (gemaakt met: sudo -u postbode node /opt/bowaco-postbode/src/sleutel.ts /etc/bowaco-postbode/robot.json)
ROBOT_KEY_FILE=/etc/bowaco-postbode/robot.json

# Maildienst: brevo (echt) of bestand (lokale mailvanger, verstuurt niets).
MAIL_PROVIDER=brevo
BREVO_API_KEY=VUL-HIER-DE-SLEUTEL-IN
# 1 = testmodus van Brevo: Brevo aanvaardt de mail maar verstuurt niets. Pas op 0 zetten na de proef (stap 7 van docs/postbode-installatie.md).
BREVO_SANDBOX=1

# Afzender (een adres op het BOWACO-domein dat in Brevo geverifieerd is) en antwoordadres (kantoor).
MAIL_FROM=BOWACO werven <planning@bowaco.eu>
MAIL_REPLY_TO=info@bowaco.eu

# Technisch logboek (sleutels, geen inhoud) en elke hoeveel seconden de wachtrij gelezen wordt.
JOURNAL_FILE=/var/lib/bowaco-postbode/journaal.jsonl
POLL_SECONDS=120

# HTTP (enkel lokaal; Caddy zet er HTTPS voor). ALLOW_ORIGIN = het adres van de app (pas nodig in fase 3).
HTTP_HOST=127.0.0.1
HTTP_PORT=8787
ALLOW_ORIGIN=
